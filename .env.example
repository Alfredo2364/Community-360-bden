# ==========================================
# Configuración General
# ==========================================
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://tu-proyecto.vercel.app
JWT_SECRET=replace_with_strong_jwt_secret
ADMIN_USER=admin@community360.com
ADMIN_PASSWORD=replace_with_secure_password

# ==========================================
# Azure SQL Database (Motor Relacional)
# ==========================================
SQL_SERVER=your_server.database.windows.net
SQL_DATABASE=your_database
SQL_USER=your_sql_user
SQL_PASSWORD=your_sql_password
SQL_PORT=1433
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false

# ==========================================
# Azure Cosmos DB for NoSQL (Motor Documental)
# ==========================================
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_KEY=replace_with_cosmos_primary_key
COSMOS_DATABASE=community360_nosql
COSMOS_CONTAINER_INTERACCIONES=interacciones
COSMOS_CONTAINER_CUARENTENA=cuarentena
COSMOS_CONTAINER_BITACORA=bitacora_etl
