        {
          "name": "POST /api/auth/login (Guarda {{token}} automáticamente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (res && res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "    pm.environment.set('token', res.token);",
                  "    console.log('JWT guardado en {{token}}:', res.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@community360.com\",\n  \"password\": \"Admin360!2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
